# Uploaded profile pictures are served as static files only.
# Never allow scripts to run from this directory.
<FilesMatch "\.(?i:php|phtml|phar|php[0-9]|cgi|pl|py|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
